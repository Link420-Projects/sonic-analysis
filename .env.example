# Copy this file to `.env` and fill in your values.  `.env` is gitignored.

# Your OPS API token.  Create one on orpheus.network under
# Settings -> Access Settings -> API Keys.  Required for --upload.
OPS_API_TOKEN=

# Directory containing your OPS .torrent files (your torrent client's session
# or watch directory).  Mounted read-only at /torrents in the container.
TORRENT_DIR=/path/to/your/torrents

# ONLY set this if your downloaded MUSIC is in a DIFFERENT directory than the
# .torrent files (e.g. rtorrent/Deluge with a separate completed-downloads dir).
# Then also pass `--music-dir /music` on the run command.  Leave commented out
# when the album folders sit next to the .torrent files.
#MUSIC_DIR=/path/to/your/music

# Host directory to receive the results JSON (default: ./output).
#OUTPUT_DIR=./output

# Override the API endpoint (default: https://orpheus.network/ajax.php).
#OPS_API_URL=https://orpheus.network/ajax.php
